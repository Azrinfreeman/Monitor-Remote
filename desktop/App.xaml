<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="MonitorRemoteDesktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Light purple accent (the same family as the phone UI). WinUI derives its accent brushes from these. -->
            <Color x:Key="SystemAccentColor">#AF52DE</Color>
            <Color x:Key="SystemAccentColorLight1">#C77EEB</Color>
            <Color x:Key="SystemAccentColorLight2">#D79DF2</Color>
            <Color x:Key="SystemAccentColorLight3">#E5BDF7</Color>
            <Color x:Key="SystemAccentColorDark1">#8944AB</Color>
            <Color x:Key="SystemAccentColorDark2">#6E3689</Color>
            <Color x:Key="SystemAccentColorDark3">#532867</Color>
            <x:Double x:Key="CardRadius">12</x:Double>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="20" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="FontSize" Value="17" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
